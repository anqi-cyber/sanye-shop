{
  "name": "sanye-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "山野商店：Vue 3 + Node.js 全栈购物项目",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node server/index.js",
    "dev:client": "node node_modules/vite/bin/vite.js --configLoader native",
    "build": "vite build --configLoader native",
    "start": "node server/index.js",
    "preview": "vite preview --configLoader native",
    "test": "node server/app.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.5"
  }
}
